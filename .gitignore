# Runtime state — bind-mounted from the host, never committed.
# NOTE: built-in plugins under numbers_go_up/plugins/ ARE tracked source and
# are not ignored. Only a deployment host's user-plugin directory is runtime
# state, and that lives next to docker-compose.yml on the host, not in a
# clone of this repo.
/data/
/config/
config.yaml
*.db
*.db-wal
*.db-shm

# Python
# Generated by setuptools-scm (write_to in pyproject.toml); never committed.
numbers_go_up/_version.py
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Claude Code agent worktree scratch space — never project content.
.claude/

# MkDocs build output (mkdocs.yml -> site_dir).
/site/

# Generated by scripts/export_openapi.py on every docs build -- see that
# script's docstring for why it lives under docs/ instead of outside it.
/docs/assets/openapi.json

# scripts/demo/seed.py and export.py's default local outputs (*.db above
# already covers demo-seed.db).
/demo-dist/

# Generated by scripts/generate_config_reference.py on every docs build.
/docs/getting-started/config-reference.md

# Generated by scripts/generate_metric_catalogue.py on every docs build.
/docs/plugins/metrics.md
