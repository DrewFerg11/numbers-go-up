{
  "openapi": "3.1.0",
  "info": {
    "title": "numbers-go-up",
    "description": "Self-hosted, plugin-based tracker for the counters you care about, with history, rate-of-change, and a Home Assistant integration. This is the REST API a running instance exposes; see the project's [README](https://github.com/DrewFerg11/numbers-go-up) for setup.",
    "contact": {
      "name": "numbers-go-up",
      "url": "https://github.com/DrewFerg11/numbers-go-up"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/DrewFerg11/numbers-go-up/blob/main/LICENSE"
    },
    "version": "0.1.dev1"
  },
  "paths": {
    "/api/stats/latest": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Latest value and staleness for every active metric",
        "description": "Batched (#128): one connection for the whole request rather than\n2-3 fresh connections (5 PRAGMAs each) per series -- with 500 active\nseries this endpoint was measurably slower than /api/stats/overview,\nwhich does far more work but was already batched (#91).",
        "operationId": "stats_latest_api_stats_latest_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsLatestResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/history": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Time series and bucketed change bars for one metric",
        "operationId": "stats_history_api_stats_history_get",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Metric"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 8760,
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "title": "Hours"
            }
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "1H",
                    "6H",
                    "12H",
                    "1D",
                    "1W",
                    "1M",
                    "3M",
                    "1Y",
                    "ALL"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Range"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsHistoryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/stats/delta": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Change and rate over a trailing window for one metric",
        "operationId": "stats_delta_api_stats_delta_get",
        "parameters": [
          {
            "name": "metric",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Metric"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 8760,
              "exclusiveMinimum": 0,
              "title": "Hours"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatsDeltaResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics": {
      "get": {
        "tags": [
          "metrics"
        ],
        "summary": "Catalogue of every metric series that has ever existed",
        "operationId": "list_metrics_api_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListMetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/plugins": {
      "get": {
        "tags": [
          "plugins"
        ],
        "summary": "Poll status for every discovered plugin",
        "operationId": "list_plugins_api_plugins_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListPluginsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/integrations": {
      "get": {
        "tags": [
          "integrations"
        ],
        "summary": "Status of the maintenance job, MQTT publisher, and milestone webhooks",
        "description": "Status of background integrations that aren't a plugin poll: the\nscheduled maintenance job (pruning, backups, PRAGMA tuning), the MQTT\npublisher, and milestone webhooks. Never includes a password, broker\ncredential, or webhook URL -- only connectivity/delivery status.",
        "operationId": "integrations_api_integrations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/plugins": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Plugin health for uptime monitors",
        "description": "Plugin health for uptime monitors: 200 when every enabled plugin is\npolling successfully, 503 when any is blocked or has failed ``failures``\nfinished polls in a row. Disabled plugins are ignored, and so is a plugin\nthat hasn't finished its first poll yet.\n\nSeparate from /health on purpose: that one is liveness, and a source\nbeing down is no reason for Docker to restart the container.",
        "operationId": "plugins_health_health_plugins_get",
        "parameters": [
          {
            "name": "failures",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 3,
              "title": "Failures"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PluginsHealthResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "description": "Liveness only: 200 while the process serves requests. Deliberately\nignores plugin state -- a source being down is not a reason to restart\nthe container. Monitor plugin polling with ``/health/plugins``.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
